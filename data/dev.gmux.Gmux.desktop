[Desktop Entry]
Name=Gmux
Comment=Persistent local and remote terminals
Exec=gmux-gtk
Icon=dev.gmux.Gmux
Terminal=false
Type=Application
Categories=GNOME;GTK;System;TerminalEmulator;
Keywords=terminal;shell;workspace;remote;connection;agent;ghostty;
StartupNotify=true
StartupWMClass=dev.gmux.Gmux
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=gmux-gtk --new-window
