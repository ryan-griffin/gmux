+pub fn gmux_image_geometry(
+    iterator_: ImageIterator,
+    source_subpixels: *[4]u32,
+    virtual_anchor: *[4]u32,
+    runs_stamp: *u64,
+    fit_rows: *[2]u32,
+) callconv(lib.calling_conv) u8 {
+    if (comptime !lib.feature(.render_state)) return 0;
+    const it = iterator_ orelse return 0;
+    const placement = it.current orelse return 0;
+    source_subpixels.* = placement.source_subpixels;
+    fit_rows.* = placement.fit_rows orelse @splat(0);
+    if (placement.virtual_anchor) |anchor| {
+        runs_stamp.* = anchor.runs_stamp;
+        virtual_anchor.* = .{
+            anchor.key.image_id,
+            anchor.key.placement_id.id,
+            @intFromEnum(anchor.key.placement_id.tag),
+            anchor.column,
+        };
+    }
+    return @intFromEnum(placement.sizing);
+}
