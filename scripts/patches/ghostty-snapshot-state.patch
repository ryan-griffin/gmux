+/// Count encoded hyperlink references without decoding the cell contents.
+pub fn countLinks(data: []const u8, cols: u16, rows: u16) DecodeError!usize {
+    var rest = data;
+    var links: usize = 0;
+    for (0..rows) |_| {
+        if (rest.len < 3) return error.EndOfStream;
+        const row: Row = @bitCast(rest[0]);
+        const cells = std.mem.readInt(u16, rest[1..3], .little);
+        if (cells > cols) return error.InvalidRowCellCount;
+        const end = 3 + @as(usize, cells) * row.cell_width.size();
+        if (end > rest.len) return error.EndOfStream;
+        const bytes = rest[3..end];
+        rest = rest[end..];
+        if (row.cell_width != .eight) continue;
+
+        // Only full-width cells carry an ID, in the most significant 16 bits.
+        const offset = @bitOffsetOf(Cell, "hyperlink_id") / 8;
+        for (0..cells) |i| {
+            const id = std.mem.readInt(u16, bytes[i * 8 + offset ..][0..2], .little);
+            links += @intFromBool(id != 0);
+        }
+    }
+    return links;
+}
