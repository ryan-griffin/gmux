+/// Start a fresh shell without erasing either screen or scrollback.
+pub fn prepare_shell(terminal: terminal_c.Terminal) callconv(lib.calling_conv) Result {
+    const t = terminal_c.zigTerminal(terminal) orelse return .invalid_value;
+    const primary = t.screens.get(.primary).?;
+    var screens = t.screens.all.iterator();
+    while (screens.next()) |entry| {
+        const screen = entry.value.*;
+        screen.endHyperlink();
+        screen.saved_cursor = null;
+        screen.charset = .{};
+        screen.kitty_keyboard = .{};
+        screen.protected_mode = .off;
+        screen.semantic_prompt.click = .none;
+        screen.cursor.semantic_content = .output;
+        screen.cursor.semantic_content_clear_eol = false;
+        screen.cursor.protected = false;
+        screen.cursor.pending_wrap = false;
+        screen.setAttribute(.unset) catch unreachable;
+        if (comptime build_options.kitty_graphics) {
+            if (screen.kitty_images.loading) |loading| loading.destroy(t.gpa());
+            screen.kitty_images.loading = null;
+        }
+    }
+    t.screens.switchTo(.primary);
+
+    // The new process starts with default input and editing protocols.
+    // Retain display modes and the explicitly selected cursor appearance.
+    const previous = t.modes;
+    // Cursor shape is per-screen, but the default flag and blink are global.
+    if (primary.cursor.cursor_style != t.cursor.default_style or
+        previous.values.cursor_blinking != (t.cursor.default_blink orelse true))
+    {
+        t.cursor.is_default = false;
+    }
+    t.modes = .{ .values = .{
+        .reverse_colors = previous.values.reverse_colors,
+        .cursor_blinking = previous.values.cursor_blinking,
+        .grapheme_cluster = previous.values.grapheme_cluster,
+    } };
+    t.flags.mouse_event = .none;
+    t.flags.mouse_format = .x10;
+    t.flags.mouse_shift_capture = .null;
+    t.flags.modify_other_keys_2 = false;
+    t.flags.password_input = false;
+    t.flags.shell_redraws_prompt = .true;
+    t.flags.dirty.clear = true;
+    t.mouse_shape = .text;
+    t.previous_char = null;
+    t.status_display = .main;
+    t.scrolling_region = .{ .top = 0, .bottom = t.rows - 1, .left = 0, .right = t.cols - 1 };
+    t.title.clearAndFree(t.gpa());
+    t.pwd.clearAndFree(t.gpa());
+
+    const has_placements = if (comptime build_options.kitty_graphics)
+        primary.kitty_images.placements.count() > 0
+    else
+        false;
+    var render: @import("../render.zig").RenderState = .empty;
+    defer render.deinit(t.gpa());
+    var image_bottom: i64 = -1;
+    if (has_placements) {
+        t.scrollViewport(.bottom);
+        render.update(t.gpa(), t) catch return .out_of_memory;
+        var images = render.imagePlacementIterator();
+        while (images.next()) |image| {
+            if (image.layer != .above_text) continue;
+            image_bottom = @max(image_bottom, @as(i64, image.y) + image.rows - 1);
+        }
+    }
+
+    // Reuse an empty trailing row or scroll once to make room for the shell.
+    const Cell = @import("../page.zig").Cell;
+    var y = t.rows - 1;
+    var rows = primary.pages.rowIterator(.left_up, .{ .active = .{} }, null);
+    while (rows.next()) |row| {
+        const metadata = row.rowAndCell().row;
+        if (y <= image_bottom or metadata.semantic_prompt != .none or
+            metadata.wrap_continuation or !Cell.isEmptyAll(row.cells(.all)))
+        {
+            primary.cursorAbsolute(0, y);
+            t.index() catch return .out_of_memory;
+            break;
+        }
+        if (y == 0) {
+            primary.cursorAbsolute(0, 0);
+            break;
+        }
+        y -= 1;
+    }
+
+    if (comptime build_options.kitty_graphics) {
+        if (has_placements) {
+            // Images that extend into the new shell's row keep the part
+            // above it. Cell metrics can differ between subscribers.
+            render.update(t.gpa(), t) catch return .out_of_memory;
+            var images = render.imagePlacementIterator();
+            var changed = false;
+            while (images.next()) |image| {
+                if (image.layer != .above_text or image.y > primary.cursor.y) continue;
+                const key = image.storage_key orelse continue;
+                const available: u32 = @intCast(@as(i64, primary.cursor.y) - image.y);
