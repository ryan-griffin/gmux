+// Decoded outlines borrowed by the Gmux renderer bridge.
+const GmuxGlyph = extern struct {
+    revision: u64,
+    points: [*]const @import("../../font/opentype/glyf.zig").Glyf.Outline.Point,
+    point_count: usize,
+    contours: [*]const u16,
+    contour_count: usize,
+    pad: [4]f64,
+    codepoint: u32,
+    upm: u32,
+    advance: u32,
+    line_height: u32,
+    ymin: i32,
+    width: u8,
+    size: u8,
+    horizontal: u8,
+    vertical: u8,
+    declared_extent: bool,
+};
+
+pub fn gmux_glyphs(
+    terminal: Terminal,
+    known: u64,
+    userdata: ?*anyopaque,
+    callback: ?*const fn (?*anyopaque, *const GmuxGlyph) callconv(lib.calling_conv) void,
+) callconv(lib.calling_conv) u64 {
+    const native = zigTerminal(terminal) orelse return 0;
+    const glossary = &native.glyph_glossary;
+    if (glossary.revision != known) if (callback) |emit| {
+        for (glossary.entries.keys(), glossary.entries.values()) |cp, entry| {
+            const outline = entry.glyph.glyf;
+            emit(userdata, &.{
+                .revision = entry.revision,
+                .points = outline.points.ptr,
+                .point_count = outline.points.len,
+                .contours = outline.contours.ptr,
+                .contour_count = outline.contours.len,
+                .pad = .{ entry.pad.top, entry.pad.right, entry.pad.bottom, entry.pad.left },
+                .codepoint = cp,
+                .upm = entry.design.units_per_em,
+                .advance = entry.design.advance_width,
+                .line_height = entry.design.line_height,
+                .ymin = entry.ymin,
+                .width = @intFromEnum(entry.width),
+                .size = @intFromEnum(entry.size),
+                .horizontal = @intFromEnum(entry.alignment.horizontal),
+                .vertical = @intFromEnum(entry.alignment.vertical),
+                .declared_extent = entry.declared_extent,
+            });
+        }
+    };
+    return glossary.revision;
+}
