# Official Arch base-20260906.0.587075, pinned independently of its mutable tag.
FROM docker.io/library/archlinux@sha256:b944cc65c5f28665dfd5fdbf5ed2997c88f5bb4a0aefac7ee8a7ef01893e5ed9

# Freeze the complete package set, including transitive dependencies. Pacman
# verifies package signatures against the base image's Arch keyring.
RUN printf 'Server = https://archive.archlinux.org/repos/2026/10/01/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist \
    && pacman -Syu --noconfirm --needed \
        base-devel curl git python python-gobject gdk-pixbuf2 librsvg \
        gtk4 libadwaita clang rustup \
    && pkg-config --atleast-version=4.22 gtk4 \
    && pkg-config --atleast-version=1.9 libadwaita-1 \
    && python -c 'import ctypes; ctypes.CDLL("libclang.so")' \
    && python -c 'import sys; assert sys.version_info >= (3, 12); import gi; gi.require_version("GdkPixbuf", "2.0"); from gi.repository import GdkPixbuf; assert any("svg" in f.get_extensions() for f in GdkPixbuf.Pixbuf.get_formats())' \
    && rm -rf /var/cache/pacman/pkg/*

ENV CARGO_HOME=/workspace/.ci-cache/cargo \
    RUSTUP_HOME=/workspace/.ci-cache/rustup \
    ZIG_GLOBAL_CACHE_DIR=/workspace/.ci-cache/zig \
    XDG_CACHE_HOME=/workspace/.ci-cache/xdg \
    SHELL=/bin/bash \
    LANG=C.UTF-8
WORKDIR /workspace
